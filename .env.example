# --- Server ---
NODE_ENV=development
PORT=3000
# Set to 1 when running behind a reverse proxy so req.ip / rate limiting use X-Forwarded-For
TRUST_PROXY=0
LOG_LEVEL=info

# --- Data stores ---
DATABASE_URL=postgres://tac:tac@localhost:5432/tac
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30

# --- Rate limiting (fixed window, Redis backed) ---
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# --- Dev conveniences ---
# There is no email service in this project. When true, invitation and password reset tokens
# are returned in API responses so you can demo the flows. MUST be false in production.
EXPOSE_DEV_TOKENS=true
